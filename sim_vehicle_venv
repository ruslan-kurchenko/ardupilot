#!/bin/bash
# Wrapper script to run sim_vehicle.py with the virtual environment

# Set the virtual environment path
VENV_PATH="/home/walle/venv-ardupilot"

# Check if virtual environment exists
if [ ! -d "$VENV_PATH" ]; then
    echo "Error: Virtual environment not found at $VENV_PATH"
    exit 1
fi

# Get the directory of this script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Activate the virtual environment
source "$VENV_PATH/bin/activate"

# Set PATH to prioritize virtual environment binaries
export PATH="$VENV_PATH/bin:$PATH"

# Ensure Python from venv is used
export PYTHON="$VENV_PATH/bin/python3"

# Run sim_vehicle.py with all arguments
exec "$PYTHON" "$SCRIPT_DIR/Tools/autotest/sim_vehicle.py" "$@"